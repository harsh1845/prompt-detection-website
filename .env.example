# Email delivery for the get-in-touch form (Resend)
# 1. Create a free account at https://resend.com
# 2. Create an API key and paste it below
# 3. Set CONTACT_EMAIL to the inbox that should receive leads
# While testing, Resend's onboarding@resend.dev can only send TO your Resend account email.

RESEND_API_KEY=re_xxxxxxxx
CONTACT_EMAIL=you@yourdomain.com

# Optional — use your verified domain in production:
# CONTACT_FROM=PromptGuard <hello@yourdomain.com>

# Lightweight detector backend URL
# Local example: http://127.0.0.1:8000
# Render example: https://promptguard-lightweight-api.onrender.com
DETECTOR_API_URL=http://127.0.0.1:8000

# Dashboard database (Prisma). SQLite locally; swap for Postgres in production.
DATABASE_URL=file:./prisma/dev.db

# Absolute base URL, used to build invite links
APP_URL=http://localhost:3000

# Optional Python red-team job server (detector repo: uvicorn redteam.server:app)
# REDTEAM_RUNNER_URL=http://127.0.0.1:8088

# Shared secret for GET /api/cron/red-team (weekly schedules). Required in production.
# CRON_SECRET=change-me
